{
  "name": "formbuilder-ionic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated Ionic UI prototype for the Epicollect5 formbuilder",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch --serve",
    "start": "npm run dev",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest"
  },
  "dependencies": {
    "@ionic/core": "8.8.4",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ionicons": "8.0.13"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jquery": "4.0.0",
    "jquery-ui": "1.14.2",
    "jsdom": "29.1.1",
    "sass": "1.67.0",
    "vitest": "4.0.18"
  }
}
